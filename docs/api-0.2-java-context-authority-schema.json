{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refactorkit.org/schemas/api-0.2-java-context-authority.json",
  "title": "Explicit Java context authority",
  "description": "javaContext supplied to intelligence.query and SDK-bound refactoring. Architecture: docs/arc42/appendix-requirements.adoc.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sdkHome",
    "expectedContextHash"
  ],
  "properties": {
    "sdkHome": {
      "type": "string",
      "minLength": 1
    },
    "expectedContextHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contextSchemaVersion": {
      "enum": [
        "java-project-context-v2",
        "java-project-context-v3",
        "java-project-context-v4",
        "java-project-context-v5",
        "java-project-context-v6",
        "java-project-context-v7"
      ],
      "default": "java-project-context-v2",
      "description": "Echo the schemaVersion from the acquired project.context response."
    }
  }
}
