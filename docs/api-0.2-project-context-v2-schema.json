{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refactorkit.org/schemas/api-0.2-project-context-v2.json",
  "title": "RefactorKit API 0.2 project.context response v2",
  "description": "Wire authority for the readonly Java project context including source-root provenance, compiler settings, resolved artifact coordinates, annotation processors, and JPMS facts. ARC42 owns integrated status. This context is not mutation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "snapshotHash",
    "contextHash",
    "sdk",
    "providers",
    "modules",
    "buildEvidence",
    "selectedSource",
    "analysis",
    "refusal"
  ],
  "properties": {
    "schemaVersion": {
      "const": "java-project-context-v2"
    },
    "status": {
      "enum": [
        "available",
        "partial",
        "refused"
      ]
    },
    "snapshotHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contextHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sdk": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sdk"
      },
      "maxItems": 18
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      },
      "maxItems": 16
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      },
      "maxItems": 1024
    },
    "buildEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "maxItems": 16384
    },
    "selectedSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/sourceAssociation"
        },
        {
          "type": "null"
        }
      ]
    },
    "analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/analysis"
        },
        {
          "type": "null"
        }
      ]
    },
    "refusal": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "fingerprint"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 8192
        },
        "kind": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home",
        "sourceRelease",
        "platformRelease",
        "identitySha256",
        "releaseMetadataSha256",
        "signatureArchive",
        "signatureArchiveSha256"
      ],
      "properties": {
        "home": {
          "type": "string",
          "maxLength": 8192
        },
        "sourceRelease": {
          "type": "integer",
          "minimum": 8,
          "maximum": 27,
          "not": {"const": 26}
        },
        "platformRelease": {
          "type": "integer",
          "minimum": 8
        },
        "identitySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "releaseMetadataSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signatureArchive": {
          "type": "string",
          "maxLength": 8192
        },
        "signatureArchiveSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "status",
        "strategy",
        "buildCodeExecution",
        "credentialsAccess",
        "networkAccess",
        "diagnostics"
      ],
      "properties": {
        "providerId": {
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "partial",
            "offline-missing",
            "unavailable",
            "execution-refused"
          ]
        },
        "strategy": {
          "type": "string"
        },
        "buildCodeExecution": {
          "type": "string"
        },
        "credentialsAccess": {
          "type": "string"
        },
        "networkAccess": {
          "type": "string"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 500
        }
      }
    },
    "classpathEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "providerId",
        "moduleId",
        "sourceSetId",
        "dependencyScope",
        "fingerprint",
        "artifact"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 8192
        },
        "providerId": {
          "type": "string"
        },
        "moduleId": {
          "type": "string"
        },
        "sourceSetId": {
          "type": "string"
        },
        "dependencyScope": {
          "anyOf": [
            {
              "enum": [
                "compile",
                "provided",
                "runtime",
                "test",
                "system",
                "custom"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/resolvedArtifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleId",
        "scope"
      ],
      "properties": {
        "moduleId": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "compile",
            "provided",
            "runtime",
            "test",
            "system",
            "custom"
          ]
        }
      }
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "sourceLevel",
        "release",
        "sourceRoots",
        "generatedSourceRoots",
        "outputDirectories",
        "analysisSourceRoots",
        "compileClasspath",
        "runtimeClasspath",
        "moduleDependencies",
        "sourceRootEvidence",
        "compilerOptionsAvailability",
        "compilerOptionsRefusalCode",
        "compilerOptions",
        "resolvedArtifactAvailability",
        "resolvedArtifactRefusalCode",
        "resolvedArtifacts",
        "annotationProcessors",
        "jpms"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "main",
            "test",
            "integration-test",
            "custom"
          ]
        },
        "sourceLevel": {
          "type": "integer",
          "minimum": 8,
          "maximum": 25
        },
        "release": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 8,
              "maximum": 25
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 8192
          },
          "maxItems": 256
        },
        "generatedSourceRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 8192
          },
          "maxItems": 256
        },
        "outputDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 8192
          },
          "maxItems": 256
        },
        "analysisSourceRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 8192
          },
          "maxItems": 16384
        },
        "compileClasspath": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classpathEntry"
          },
          "maxItems": 4096
        },
        "runtimeClasspath": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classpathEntry"
          },
          "maxItems": 4096
        },
        "moduleDependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "maxItems": 1024
        },
        "sourceRootEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRootEvidence"
          },
          "maxItems": 4096
        },
        "compilerOptionsAvailability": {
          "enum": [
            "complete",
            "not-declared",
            "partial",
            "unavailable",
            "ambiguous"
          ]
        },
        "compilerOptionsRefusalCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "compilerOptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compilerOption"
          },
          "maxItems": 1024
        },
        "resolvedArtifactAvailability": {
          "enum": [
            "complete",
            "not-declared",
            "partial",
            "unavailable",
            "ambiguous"
          ]
        },
        "resolvedArtifactRefusalCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "resolvedArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolvedArtifact"
          },
          "maxItems": 16384
        },
        "annotationProcessors": {
          "$ref": "#/$defs/annotationProcessors"
        },
        "jpms": {
          "$ref": "#/$defs/jpms"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "id",
        "name",
        "root",
        "sourceSets",
        "coordinates"
      ],
      "properties": {
        "providerId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "root": {
          "type": "string",
          "maxLength": 8192
        },
        "sourceSets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSet"
          },
          "maxItems": 64
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/coordinates"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sourceAssociation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "symbol",
        "moduleId",
        "sourceSetId",
        "sourceRoot",
        "generated",
        "bindingKey",
        "evidence"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 8192
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "moduleId": {
          "type": "string"
        },
        "sourceSetId": {
          "type": "string"
        },
        "sourceRoot": {
          "type": "string",
          "maxLength": 8192
        },
        "generated": {
          "type": "boolean"
        },
        "bindingKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "enum": [
            "JDT_BINDING",
            "SOURCE_ROOT_OWNERSHIP"
          ]
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "snapshotHash",
        "platformIdentitiesByRelease",
        "warningCount"
      ],
      "properties": {
        "backend": {
          "const": "eclipse-jdt"
        },
        "snapshotHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "platformIdentitiesByRelease": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "artifactId",
        "version"
      ],
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "resolvedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "coordinates",
        "extension",
        "classifier",
        "scope",
        "transitive",
        "fingerprint"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 8192
        },
        "coordinates": {
          "$ref": "#/$defs/coordinates"
        },
        "extension": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "classifier": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "compile",
                "provided",
                "runtime",
                "test",
                "system",
                "custom"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "transitive": {
          "type": "boolean"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sourceRootEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "origin",
        "providerId",
        "descriptorPath",
        "profileId",
        "pluginId",
        "executionId",
        "goal",
        "phase",
        "availability"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 8192
        },
        "origin": {
          "enum": [
            "conventional",
            "build-descriptor",
            "build-plugin",
            "generated"
          ]
        },
        "providerId": {
          "type": "string",
          "maxLength": 128
        },
        "descriptorPath": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "profileId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "pluginId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "executionId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "goal": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "enum": [
            "complete",
            "not-declared",
            "partial",
            "unavailable",
            "ambiguous"
          ]
        }
      }
    },
    "compilerOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "origin",
        "redacted"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "value": {
          "type": "string",
          "maxLength": 16384
        },
        "origin": {
          "type": "string",
          "maxLength": 512
        },
        "redacted": {
          "type": "boolean"
        }
      }
    },
    "annotationProcessors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "processorPath",
        "dependencies",
        "processorNames",
        "options",
        "mode",
        "refusalCode"
      ],
      "properties": {
        "availability": {
          "enum": [
            "complete",
            "not-declared",
            "partial",
            "unavailable",
            "ambiguous"
          ]
        },
        "processorPath": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 8192
          },
          "maxItems": 256
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolvedArtifact"
          },
          "maxItems": 256
        },
        "processorNames": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 256
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 16384
          },
          "maxProperties": 256
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "refusalCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleName",
        "modifiers"
      ],
      "properties": {
        "moduleName": {
          "type": "string",
          "maxLength": 512
        },
        "modifiers": {
          "type": "array",
          "items": {
            "enum": [
              "static",
              "transitive"
            ]
          },
          "maxItems": 2
        }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "targets"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "maxLength": 1024
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 1024
        }
      }
    },
    "moduleDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "moduleName",
        "open",
        "requires",
        "exports",
        "contentSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 8192
        },
        "moduleName": {
          "type": "string",
          "maxLength": 512
        },
        "open": {
          "type": "boolean"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requires"
          },
          "maxItems": 1024
        },
        "exports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exports"
          },
          "maxItems": 1024
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "modulePathEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "moduleNames",
        "fingerprint"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 8192
        },
        "moduleNames": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 4096
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "jpms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "modulePath",
        "descriptors",
        "refusalCode"
      ],
      "properties": {
        "availability": {
          "enum": [
            "complete",
            "not-declared",
            "partial",
            "unavailable",
            "ambiguous"
          ]
        },
        "modulePath": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modulePathEntry"
          },
          "maxItems": 4096
        },
        "descriptors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/moduleDescriptor"
          },
          "maxItems": 16
        },
        "refusalCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "refused"
          }
        }
      },
      "then": {
        "properties": {
          "contextHash": {
            "type": "null"
          },
          "sdk": {
            "maxItems": 0
          },
          "providers": {
            "maxItems": 0
          },
          "modules": {
            "maxItems": 0
          },
          "buildEvidence": {
            "maxItems": 0
          },
          "selectedSource": {
            "type": "null"
          },
          "analysis": {
            "type": "null"
          },
          "refusal": {
            "$ref": "#/$defs/refusal"
          }
        }
      },
      "else": {
        "properties": {
          "snapshotHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "refusal": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        }
      },
      "then": {
        "properties": {
          "sdk": {
            "minItems": 1
          },
          "providers": {
            "minItems": 1
