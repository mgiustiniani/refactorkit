    "mavenTestJvmSelection": {
      "type": "object",
      "description": "Execution JVM selection is projected by project.context.v7.testJvmSelection. Availability covers the executable selector established by captured inputs. Executable paths are literal POM facts and build-jvm refers to the Maven process. Maven may resolve declared jdkToolchain criteria before starting the fork even when an explicit jvm sets the executable.",
      "additionalProperties": false,
      "required": [
        "kind",
        "availability",
        "origin",
        "executable",
        "requirements",
        "redacted",
        "refusalCode",
        "toolchainPrerequisite"
      ],
      "properties": {
        "kind": {
          "enum": [
            "build-jvm",
            "explicit-executable",
            "toolchain",
            "unresolved"
          ]
        },
        "availability": {
          "enum": [
            "complete",
            "unavailable"
          ]
        },
        "origin": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "executable": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "requirements": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "redacted": {
          "type": "boolean"
        },
        "refusalCode": {
          "enum": [
            null,
            "java.context.mavenTestJvmSelectionUnavailable",
            "java.context.mavenTestJvmToolchainUnresolved"
          ]
        },
        "toolchainPrerequisite": {
          "description": "A captured jdkToolchain declaration that Maven can require before starting this execution. Discovery reports its resolution as unavailable and exposes only bounded literal criteria and provenance.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["availability", "origin", "requirements", "redacted", "refusalCode"],
          "properties": {
            "availability": { "const": "unavailable" },
            "origin": { "type": "string", "maxLength": 8192 },
            "requirements": {
              "type": "object",
              "maxProperties": 16,
              "additionalProperties": { "type": "string", "maxLength": 1024 }
            },
            "redacted": { "type": "boolean" },
            "refusalCode": {
              "enum": [
                "java.context.mavenTestJvmSelectionUnavailable",
                "java.context.mavenTestJvmToolchainUnresolved"
              ]
            }
          }
        }
      }
    }
